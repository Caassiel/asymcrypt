class LehmerLow{

private:
    const uint64_t m = 0x10000000;
    const uint16_t c = 119;
    const uint32_t a = 0x10001;
    uint32_t x;

public:
    LehmerLow(uint32_t x_0){x = x_0;}

    uint32_t next_byte(){
        uint32_t output = static_cast<uint32_t>((static_cast<uint64_t>(a) * x + c) % m);
        x = output;
        return output & 0xFF;
    }

};

//3

class LehmerHigh{

private:
    const uint64_t m = 0x10000000;
    const uint16_t c = 119;
    const uint32_t a = 0x10001;
    uint32_t x;

public:
    LehmerHigh(uint32_t x_0){x = x_0;}

    uint32_t next_byte(){
        uint32_t output = static_cast<uint32_t>((static_cast<uint64_t>(a) * x + c) % m);
        x = output;
        return (output >> 20) & 0xFF;
    }

};

