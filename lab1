class LFSR89 {

private:
    uint32_t state[3];

public:
    LFSR89(uint32_t seed) {
        state[0] = seed;
        state[1] = 0;
        state[2] = 0;
        if (seed == 0) state[0] = 1;
    }

    inline uint32_t next_bit() {
        uint32_t output = state[0] & 1u;
        uint32_t feedback = (state[0] & 1u) ^ ((state[1] >> 19) & 1u);

        state[0] = (state[0] >> 1) | (state[1] << 31);
        state[1] = (state[1] >> 1) | (state[2] << 31);
        state[2] = (state[2] >> 1) | (feedback << 24);

        state[2] &= 0x01FFFFFFu;

        return output;
    }
};

class L89 {

private:
    LFSR89 L;

public:

    L89(uint32_t x) : L(x) {}

    inline uint32_t next_bit() {
        return L.next_bit();
    }
};

