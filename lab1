class Blum_Micali {

private:
    mpz_class p;
    mpz_class a;
    mpz_class x;

public:
    Blum_Micali(const mpz_class& p_, const mpz_class& a_, const mpz_class& x_0) {
        p = p_;
        a = a_;
        x = x_0;
    }

    uint32_t next_bit() {
        mpz_powm(x.get_mpz_t(), a.get_mpz_t(), x.get_mpz_t(), p.get_mpz_t());
        return x > (p - 1) / 2;
    }
};

//9

class Blum_Blum_Shub {

private:
    mpz_class N;
    mpz_class x;

public:
    Blum_Blum_Shub(const mpz_class& p, const mpz_class& q, const mpz_class& x_0) {
        N = p * q;
        x = x_0;
    }

    uint32_t next_bit() {
        x = (x * x) % N;
        return mpz_tstbit(x.get_mpz_t(), 0);
    }
};


