uint32_t CyclicShiftLeft(uint32_t x, unsigned int s) {
    s %= 32;
    return (x << s) | (x >> ((32 - s) % 32));
}

uint32_t CyclicShiftRight(uint32_t x, unsigned int s) {
    s %= 32;
    return (x >> s) | (x << ((32 - s) % 32));
}

class Wolfram_Generator {

private:
    uint32_t r;

public:
    Wolfram_Generator(uint32_t r_0){r = r_0;}

    uint32_t next_bit() {
        uint32_t x = r & 1u;
        r = CyclicShiftLeft(r, 1) ^ (r | CyclicShiftRight(r, 1));
        return x;
    }

};


