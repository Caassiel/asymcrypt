        "Wolfram",
        [](uint64_t seed) {
            Wolfram_Generator gen(static_cast<uint32_t>(seed));
            return GenerateByteSequence(gen, SEQUENCE_BYTES);
        },
        seed_engine,
        output
    );

    mpz_class p2("D5BBB96D30086EC484EBA3D7F9CAEB07", 16);
    mpz_class q2("425D2B9BFDB25B9CF6C416CC6E37B59C1F", 16);
    mpz_class N = p2 * q2;

    RunExperiments(
        "Blum-Blum-Shub",
        [p2, q2, N](uint64_t seed) {
            mpz_class x0 = MakeBBSSeed(seed, N);

            Blum_Blum_Shub gen(p2, q2, x0);
            return GenerateByteSequence(gen, SEQUENCE_BYTES);
        },
        seed_engine,
        output
    );

    mpz_class p1("CEA42B987C44FA642D80AD9F51F10457690DEF10C83D0BC1BCEE12FC3B6093E3", 16);
    mpz_class a("5B88C41246790891C095E2878880342E88C79974303BD0400B090FE38A688356", 16);

    RunExperiments(
        "Blum-Micali",
        [p1, a](uint64_t seed) {
            mpz_class x0 = MakeBigSeed(seed, 4) % (p1 - 1) + 1;

            Blum_Micali gen(p1, a, x0);
            return GenerateByteSequence(gen, SEQUENCE_BYTES);
        },
        seed_engine,
        output
    );

    RunTextExperiment("input2.txt", output);

    cout << "Experiments completed.\n";
