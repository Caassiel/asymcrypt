class LFSR {
private:
    uint32_t state;
    int Size;
    vector<int> taps;
    uint32_t mask;

public:
    LFSR(uint32_t seed, int n, const vector<int>& t) {
        Size = n;
        taps = t;
        mask = (Size == 32) ? 0xFFFFFFFFu : ((1u << Size) - 1u);
        state = seed & mask;
        if (state == 0) state = 1;
    }

    inline uint32_t next_bit() {
        uint32_t output = state & 1u;
        uint32_t feedback = 0;

        for (int t : taps) feedback ^= (state >> t) & 1u;

        state >>= 1;
        state |= (feedback << (Size - 1));
        state &= mask;

        return output;
    }
};

class L20 {

private:
    LFSR L;

public:
    L20(uint32_t x):
        L(x, 20, {0,11,15,17})
    {}

    inline uint32_t next_bit() {
        return L.next_bit();
    }

};

//5

class LFSR89 {

private:
    uint32_t state[3];

public:
    explicit LFSR89(uint32_t seed) {
        state[0] = seed;
        state[1] = 0;
        state[2] = 0;
        if (seed == 0) state[0] = 1;
    }

    explicit LFSR89(const array<uint32_t, 3>& seed) {
        state[0] = seed[0];
        state[1] = seed[1];
        state[2] = seed[2] & 0x01FFFFFFu;
        if ((state[0] | state[1] | state[2]) == 0)
            state[0] = 1;
    }

    inline uint32_t next_bit() {
        uint32_t output = state[0] & 1u;
        uint32_t feedback = (state[0] & 1u) ^ ((state[1] >> 19) & 1u);

        state[0] = (state[0] >> 1) | (state[1] << 31);
        state[1] = (state[1] >> 1) | (state[2] << 31);
        state[2] = (state[2] >> 1) | (feedback << 24);

        state[2] &= 0x01FFFFFFu;

        return output;
    }
};

class L89 {

private:
    LFSR89 L;

public:
    explicit L89(uint32_t x) : L(x) {}
    explicit L89(const array<uint32_t, 3>& seed) : L(seed) {}

    inline uint32_t next_bit() {
        return L.next_bit();
    }
};

