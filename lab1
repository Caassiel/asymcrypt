double UniformityTest(const ByteSequence& seq) {
    array<uint64_t, 256> freq{};

    size_t n = seq.size();

    for (size_t i = 0; i < n; i++) freq[seq[i]]++;

    double expected = double(n) / 256.0;
    double chi = 0;

    for (int i = 0; i < 256; i++) {
        double diff = freq[i] - expected;
        chi += diff * diff / expected;
    }

    return chi;
}

double IndependenceTest(const ByteSequence& seq) {

    uint64_t freq[256][256] = {};
    uint64_t row[256] = {};
    uint64_t col[256] = {};

    size_t n = seq.size() - 1;

    for (size_t i = 0; i < n; i++) {
        uint8_t a = seq[i];
        uint8_t b = seq[i + 1];

        freq[a][b]++;
        row[a]++;
        col[b]++;
    }

    double chi = 0;

    for (int a = 0; a < 256; a++) {
        for (int b = 0; b < 256; b++) {
            double expected = double(row[a]) * col[b] / n;
            if (expected == 0) continue;
            double diff = freq[a][b] - expected;
            chi += diff * diff / expected;
        }
    }

    return chi;
}


double HomogeneityTest(const ByteSequence& seq, int r) {

    vector<array<uint64_t, 256>> freq(r);
    vector<uint64_t> row(r, 0);
    array<uint64_t, 256> col{};

    size_t n = seq.size();

    for (int k = 0; k < r; k++) {
        size_t start = n * k / r;
        size_t end   = n * (k + 1) / r;

        for (size_t i = start; i < end; i++) {
            uint8_t x = seq[i];
            freq[k][x]++;
            row[k]++;
            col[x]++;
        }
    }

    double chi = 0;

    for (int k = 0; k < r; k++) {
        for (int i = 0; i < 256; i++) {
            double expected = double(row[k]) * col[i] / n;
            if (expected == 0) continue;
            double diff = freq[k][i] - expected;
            chi += diff * diff / expected;
        }
    }

    return chi;
}



