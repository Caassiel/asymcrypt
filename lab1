class Blum_Micali {

private:
    mpz_class p;
    mpz_class a;
    mpz_class x;
    mpz_class half;

public:
    Blum_Micali(const mpz_class& p_0, const mpz_class& a_0, const mpz_class& x_0) {
        p = p_0;
        a = a_0;
        x = x_0;
        half = (p - 1) / 2;
    }

    uint32_t next_bit() {
        mpz_powm(x.get_mpz_t(), a.get_mpz_t(), x.get_mpz_t(), p.get_mpz_t());
        return x > half;
    }
};

//10
class Blum_Blum_Shub {

private:
    mpz_class N;
    mpz_class x;

public:
    Blum_Blum_Shub(const mpz_class& p, const mpz_class& q, const mpz_class& x_0) {
        N = p * q;
        x = x_0;
    }

    uint32_t next_bit() {
        x = (x * x) % N;
        return mpz_tstbit(x.get_mpz_t(), 0);
    }
};

template <typename Generator>
ByteSequence GenerateByteSequence(Generator& gen, size_t byte_count) {
    ByteSequence seq(byte_count);

    for (size_t i = 0; i < byte_count; i++) {
        uint8_t byte = 0;

        for (int bit = 0; bit < 8; bit++) {
            byte = static_cast<uint8_t>(
                (byte << 1) | (gen.next_bit() & 1u)
            );
        }

        seq.add(byte);
    }

    return seq;
}

// tests

struct AlphaLevel {
    double alpha;
    double z;
};

constexpr array<AlphaLevel, 7> ALPHA_LEVELS = {{
    {0.10,   1.281551566},
    {0.05,   1.644853627},
    {0.025,  1.959963985},
    {0.01,   2.326347874},
    {0.005,  2.575829304},
    {0.001,  3.090232306},
    {0.0001, 3.719016485}
}};

double CriticalValue(int degrees_of_freedom, double alpha) {
    for (const auto& level : ALPHA_LEVELS) {
        if (abs(level.alpha - alpha) < 1e-9) {
            double L = degrees_of_freedom;
            return L + sqrt(2.0 * L) * level.z;
        }
    }
}

double UniformityTest(const ByteSequence& seq) {
    array<uint64_t, 256> freq{};

    for (size_t i = 0; i < seq.size(); i++)
        freq[seq[i]]++;

    double expected = static_cast<double>(seq.size()) / 256.0;
    double chi = 0.0;

    for (int i = 0; i < 256; i++) {
        double diff = static_cast<double>(freq[i]) - expected;
        chi += diff * diff / expected;
    }

    return chi;
}

int UniformityDF() {
    return 255;
}

double IndependenceTest(const ByteSequence& seq,int& degrees_of_freedom) {
    uint64_t freq[256][256] = {};
    uint64_t row[256] = {};
    uint64_t col[256] = {};

    size_t n = seq.size() - 1;

    for (size_t i = 0; i < n; i++) {
        uint8_t a = seq[i] >> 4;
        uint8_t b = seq[i + 1] >> 4;

        freq[a][b]++;
        row[a]++;
        col[b]++;
    }

    int active_rows = 0;
    int active_cols = 0;

    for (int i = 0; i < 256; i++) {
        if (row[i] > 0) active_rows++;
        if (col[i] > 0) active_cols++;
    }

    degrees_of_freedom = (active_rows - 1) * (active_cols - 1);
    double chi = 0.0;

    for (int a = 0; a < 256; a++) {
        for (int b = 0; b < 256; b++) {
            if (row[a] == 0 || col[b] == 0) continue;
            double expected =static_cast<double>(row[a]) * col[b] / n;
            double diff = static_cast<double>(freq[a][b]) - expected;
            chi += diff * diff / expected;
        }
    }

    return chi;
}

double HomogeneityTest(const ByteSequence& seq, int r, int& degrees_of_freedom) {
    vector<array<uint64_t, 256>> freq(r);
    for (auto& group : freq) group.fill(0);
    vector<uint64_t> row(r, 0);
    array<uint64_t, 256> col{};
    size_t n = seq.size();

    for (int k = 0; k < r; k++) {
        size_t start = n * k / r;
        size_t end = n * (k + 1) / r;

        for (size_t i = start; i < end; i++) {
            uint8_t x = seq[i];

            freq[k][x]++;
            row[k]++;
            col[x]++;
        }
    }

    int active_cols = 0;

    for (int i = 0; i < 256; i++) {
        if (col[i] > 0) active_cols++;
    }

    degrees_of_freedom = (r - 1) * (active_cols - 1);
    double chi = 0.0;

    for (int k = 0; k < r; k++) {
        for (int i = 0; i < 256; i++) {
            if (col[i] == 0) continue;
            double expected = static_cast<double>(row[k]) * col[i] / n;
            double diff = static_cast<double>(freq[k][i]) - expected;
            chi += diff * diff / expected;
        }
    }

    return chi;
}

struct TestResult {
    double chi_squared;
    double critical_value;
    int degrees_of_freedom;
    double alpha;

    bool passed() const {
        return chi_squared <= critical_value;
    }
};

TestResult MakeResult(double chi, int L, double alpha) {
    return {
        chi,
        CriticalValue(L, alpha),
        L,
        alpha
    };
}

void PrintResult(const string& name, const TestResult& result) {
    cout << name << "\n";
    cout << "Chi-squared: " << result.chi_squared << "\n";
    cout << "Critical value: " << result.critical_value << "\n";
    cout << "Degrees of freedom: " << result.degrees_of_freedom << "\n";
    cout << "Alpha: " << result.alpha << "\n";
    cout << (result.passed() ? "Do not reject H0\n\n" : "Reject H0\n\n");
}

void RunAllTests(const ByteSequence& seq, double alpha, int groups) {
    TestResult uniformity = MakeResult(
        UniformityTest(seq),
        UniformityDF(),
        alpha
    );

    PrintResult("Uniformity test", uniformity);

    int independence_df = 0;
    double independence_chi = IndependenceTest(seq, independence_df);

    TestResult independence = MakeResult(
        independence_chi,
        independence_df,
        alpha
    );

    PrintResult("Independence test", independence);

    int homogeneity_df = 0;
    double homogeneity_chi = HomogeneityTest(seq, groups, homogeneity_df);

    TestResult homogeneity = MakeResult(
        homogeneity_chi,
        homogeneity_df,
        alpha
    );

    PrintResult("Homogeneity test", homogeneity);
}

struct TestStatistic {
    double chi_squared;
    int degrees_of_freedom;
};

struct RejectionCount {
    int rejected = 0;
    int not_rejected = 0;
};

struct TrialResults {
    TestStatistic tests[3];
};

TrialResults CalculateStatistics(const ByteSequence& seq) {
    TrialResults result;

    result.tests[0] = {
        UniformityTest(seq),
        UniformityDF()
    };

    int independence_df = 0;
    result.tests[1] = {
        IndependenceTest(seq, independence_df),
        independence_df
    };

    int homogeneity_df = 0;
    result.tests[2] = {
        HomogeneityTest(seq, GROUPS, homogeneity_df),
        homogeneity_df
    };

    return result;
}

//Seed generation

uint64_t SplitMix64(uint64_t x) {
    x += 0x9E3779B97F4A7C15ULL;
    x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ULL;
    x = (x ^ (x >> 27)) * 0x94D049BB133111EBULL;
    return x ^ (x >> 31);
}

mpz_class MakeBigSeed(uint64_t seed, size_t words = 4) {
    vector<uint64_t> values(words);
    for (size_t i = 0; i < words; ++i)
        values[i] = SplitMix64(seed + i);

    mpz_class result;
    mpz_import(result.get_mpz_t(), words, 1, sizeof(uint64_t), 0, 0, values.data());
    return result;
}

mpz_class MakeBBSSeed(uint64_t seed, const mpz_class& N) {
    mpz_class s = MakeBigSeed(seed, 5) % (N - 1) + 1;
    mpz_class gcd;

    while (true) {
        mpz_gcd(gcd.get_mpz_t(), s.get_mpz_t(), N.get_mpz_t());
        if (gcd == 1) break;
        ++s;
        if (s >= N) s = 1;
    }

    return (s * s) % N;
}

//main thing

void RunExperiments(const string& generator_name, const function<ByteSequence(uint64_t)>& generate, mt19937_64& seed_engine,ofstream& output) {
    constexpr int TEST_COUNT = 3;

    const array<string, TEST_COUNT> test_names = {
        "Uniformity",
        "Independence",
        "Homogeneity"
    };

    array<array<RejectionCount, TEST_COUNT>, ALPHA_LEVELS.size()> counts{};
    output << "Generator: " << generator_name << "\n";

    for (int trial = 0; trial < TRIALS; trial++) {
        uint64_t seed = SplitMix64(seed_engine());
        ByteSequence seq = generate(seed);
        TrialResults results = CalculateStatistics(seq);

        for (size_t a = 0; a < ALPHA_LEVELS.size(); a++) {
            double alpha = ALPHA_LEVELS[a].alpha;

            for (int t = 0; t < TEST_COUNT; t++) {
                double critical = CriticalValue(
                    results.tests[t].degrees_of_freedom,
                    alpha
                );

                if (results.tests[t].chi_squared > critical) counts[a][t].rejected++;
                else counts[a][t].not_rejected++;
            }
        }
    }

    output << left
           << setw(12) << "Alpha"
           << setw(18) << "Test"
           << setw(15) << "Rejected"
           << setw(18) << "Not rejected"
           << "\n";

    output << string(63, '-') << "\n";

    for (size_t a = 0; a < ALPHA_LEVELS.size(); a++) {
        for (int t = 0; t < TEST_COUNT; t++) {
            output << left
                   << setw(12) << ALPHA_LEVELS[a].alpha
                   << setw(18) << test_names[t]
                   << setw(15) << counts[a][t].rejected
                   << setw(18) << counts[a][t].not_rejected
                   << '\n';
        }

        output << "\n";
    }

    output << flush;
}

template <typename Generator> ByteSequence GenerateDirectByteSequence(Generator& gen, size_t byte_count) {
    ByteSequence seq(byte_count);

    for (size_t i = 0; i < byte_count; i++)
        seq.add(static_cast<uint8_t>(gen.next_byte()));

    return seq;
}


void RunTextExperiment(const string& filename, ofstream& output) {
    Text_Generator gen(filename);
    ByteSequence seq = GenerateDirectByteSequence(gen, SEQUENCE_BYTES);
    TrialResults results = CalculateStatistics(seq);

    const array<string, 3> test_names = {
        "Uniformity",
        "Independence",
        "Homogeneity"
    };

    output << "\nGenerator: Text (" << filename << ")\n";
    output << "Sequence length: " << seq.size() * 8 << " bits\n";
    output << "Trials: 1\n";
    output << "Homogeneity groups: " << GROUPS << "\n\n";

    output << left
           << setw(12) << "Alpha"
           << setw(18) << "Test"
           << setw(15) << "Rejected"
           << setw(18) << "Not rejected"
           << "\n";

    output << string(63, '-') << "\n";

    for (size_t a = 0; a < ALPHA_LEVELS.size(); a++) {
        double alpha = ALPHA_LEVELS[a].alpha;

        for (int t = 0; t < 3; t++) {
            double critical = CriticalValue(
                results.tests[t].degrees_of_freedom,
                alpha
            );

            bool rejected = results.tests[t].chi_squared > critical;

            output << left
                   << setw(12) << alpha
                   << setw(18) << test_names[t]
                   << setw(15) << (rejected ? 1 : 0)
                   << setw(18) << (rejected ? 0 : 1)
                   << '\n';
        }

        output << "\n";
    }

    output << flush;
}




int main() {
    ofstream output("experiment_results.txt");
    uint64_t clock_seed = static_cast<uint64_t>(chrono::high_resolution_clock::now().time_since_epoch().count());
    mt19937_64 seed_engine(clock_seed);

    output << "Initial clock seed: " << clock_seed << "\n";
    output << "Sequence length: " << SEQUENCE_BITS << " bits\n";
    output << "Trials per generator: " << TRIALS << "\n";

    RunExperiments(
        "Default",
        [](uint64_t seed) {
            Default gen(seed);
            return GenerateByteSequence(gen, SEQUENCE_BYTES);
        },
        seed_engine,
        output
    );

    RunExperiments(
        "Lehmer Low",
        [](uint64_t seed) {
            LehmerLow gen(static_cast<uint32_t>(seed));
            return GenerateDirectByteSequence(gen, SEQUENCE_BYTES);
        },
        seed_engine,
        output
    );

    RunExperiments(
        "Lehmer High",
        [](uint64_t seed) {
            LehmerHigh gen(static_cast<uint32_t>(seed));
            return GenerateDirectByteSequence(gen, SEQUENCE_BYTES);
        },
        seed_engine,
        output
    );

    RunExperiments(
        "L20",
        [](uint64_t seed) {
            L20 gen(static_cast<uint32_t>(seed));
            return GenerateByteSequence(gen, SEQUENCE_BYTES);
        },
        seed_engine,
        output
    );

    RunExperiments(
        "L89",
        [](uint64_t seed) {
            array<uint32_t, 3> state = {
                static_cast<uint32_t>(SplitMix64(seed)),
                static_cast<uint32_t>(SplitMix64(seed + 1)),
                static_cast<uint32_t>(SplitMix64(seed + 2))
            };

            L89 gen(state);
