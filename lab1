class LFSR {
private:
    uint32_t state;
    int Size;
    vector<int> taps;
    uint32_t mask;

public:
    LFSR(uint32_t seed, int n, const vector<int>& t) {
        Size = n;
        taps = t;
        mask = (Size == 32) ? 0xFFFFFFFFu : ((1u << Size) - 1u);
        state = seed & mask;
        if (state == 0) state = 1;
    }

    inline uint32_t next_bit() {
        uint32_t output = state & 1u;
        uint32_t feedback = 0;

        for (int t : taps) feedback ^= (state >> t) & 1u;

        state >>= 1;
        state |= (feedback << (Size - 1));
        state &= mask;

        return output;
    }
};


class L20 {

private:
    LFSR L;

public:
    L20(uint32_t x):
        L(x, 20, {0,11,15,17})
    {}

    inline uint32_t next_bit() {
        return L.next_bit();
    }

};

